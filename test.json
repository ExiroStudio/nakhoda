        "Command": "/bin/sh -c 'node -e '\nconst fs = require(\"fs\");\ntry {\n  let code = fs.readFileSync(\"/app/dist/app.js\", \"utf8\");\n  const target = \"done(null);\\n  });\";\n  if (!code.includes(\"Access-Control-Allow-Origin\")) {\n    const hook = `done(null);\n  });\n  app.addHook(\"onRequest\", async (request, reply) => {\n    const origin = request.headers.origin || \"*\";\n    reply.header(\"Access-Control-Allow-Origin\", origin);\n    reply.header(\"Access-Control-Allow-Methods\", \"GET, HEAD, PUT, POST, DELETE, PATCH, OPTIONS\");\n    reply.header(\"Access-Control-Allow-Headers\", \"*\");\n    reply.header(\"Access-Control-Expose-Headers\", \"*\");\n    reply.header(\"Access-Control-Allow-Credentials\", \"true\");\n    if (request.method === \"OPTIONS\") {\n      return reply.status(204).send();\n    }\n  });`;\n    fs.writeFileSync(\"/app/dist/app.js\", code.replace(target, hook));\n    console.log(\"✅ [Storage] Injected CORS preflight & headers into Fastify app\");\n  }\n} catch (e) {\n  console.error(\"⚠️ [Storage] Could not inject CORS:\", e);\n}\n'\nexec node dist/start/server.js\n'",
